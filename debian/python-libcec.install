# cmake hangs the module off CMAKE_INSTALL_LIBDIR, which debhelper sets to the
# multiarch triplet; Debian's sys.path has only /usr/lib/python3/dist-packages
usr/lib*{/*,}/python*/dist-packages/cec.py usr/lib/python3/dist-packages
usr/lib*{/*,}/python*/dist-packages/_pycec*.so usr/lib/python3/dist-packages
usr/bin/pyCecClient
